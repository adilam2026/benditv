# ── Base de données ──────────────────────────────────────────────
# Avec Docker : docker compose up -d db  (voir docker-compose.yml)
DATABASE_URL="postgresql://recofiable:recofiable@localhost:5432/recofiable"

# ── Sécurité ─────────────────────────────────────────────────────
# Secret de session (générer avec : openssl rand -hex 32)
SESSION_SECRET="changez-moi-en-production"

# ── Application ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Intégrations externes (facultatives, mode démo si absentes) ──
# Adaptateur IA (compréhension de requêtes / synthèses). Sans clé,
# le mode local à base de règles est utilisé automatiquement.
AI_PROVIDER="local"            # local | openai-compatible
AI_API_KEY=""
AI_API_URL=""

# Paiement des abonnements professionnels. Sans clé, le mode
# fictif "demo" génère des factures de démonstration.
PAYMENT_PROVIDER="demo"        # demo | stripe
STRIPE_SECRET_KEY=""

# Fournisseur de lieux (import). "demo" = données fictives locales.
PLACES_PROVIDER="demo"

# Envoi d'e-mails. "console" = les e-mails sont affichés dans les
# journaux du serveur (aucun envoi réel).
MAIL_PROVIDER="console"        # console | smtp
SMTP_URL=""

# Connexion sociale (abstraction, non activée sans identifiants)
SOCIAL_LOGIN_ENABLED="false"
